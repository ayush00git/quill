{
  "description": "quill: lock the pr-reviewer subagent to read-only workspace access",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
